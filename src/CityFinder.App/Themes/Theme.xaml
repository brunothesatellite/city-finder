<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Georgia</FontFamily>

    <SolidColorBrush x:Key="AppBg" Color="#F7F3EA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0EADD"/>
    <SolidColorBrush x:Key="Border" Color="#DDD3C2"/>
    <SolidColorBrush x:Key="Ink" Color="#23281F"/>
    <SolidColorBrush x:Key="InkMuted" Color="#6E7267"/>
    <SolidColorBrush x:Key="Accent" Color="#2E5D46"/>
    <SolidColorBrush x:Key="AccentInk" Color="#F7FBF8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E2EEE6"/>
    <SolidColorBrush x:Key="Warning" Color="#98601F"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#F8EBD9"/>
    <SolidColorBrush x:Key="Danger" Color="#9C3B32"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#F8E3DE"/>
    <SolidColorBrush x:Key="MapBg" Color="#E7E1D4"/>
    <SolidColorBrush x:Key="Overlay" Color="#B3F7F3EA"/>
