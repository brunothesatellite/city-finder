<Window x:Class="CityFinder.App.Views.RenameResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CityFinder.App.Views"
        Title="Renommage terminé"
        Icon="pack://application:,,,/Assets/CityFinder.ico"
        Width="680" Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:DialogTitleBar Grid.Row="0" Title="Renommage terminé"
                                  CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                <TextBlock Text="✓" FontSize="22" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontFamily="Georgia" FontSize="26"/>
                <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource InkMuted}" FontSize="12"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border x:Name="FailurePanel" Grid.Row="1" Background="{DynamicResource WarningSoft}"
                BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="12"
                Padding="14" Margin="0,20,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FailureTitle" FontWeight="SemiBold"
                           Foreground="{DynamicResource Warning}"/>
                <ItemsControl x:Name="FailureList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Warning}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="WarningPanel" Grid.Row="2" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12"
                Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
            <ItemsControl x:Name="WarningList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource InkMuted}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="3" x:Name="FooterHint"
                   Text="Les noms d'origine sont conservés dans .cityfinder.json : vous pouvez annuler ce renommage."
                   Foreground="{DynamicResource InkMuted}" FontSize="11.5" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="2,20,0,0"/>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Button x:Name="UndoButton" Content="Annuler ces renommages"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="Undo_Click"/>
            <Button Content="Fermer" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
