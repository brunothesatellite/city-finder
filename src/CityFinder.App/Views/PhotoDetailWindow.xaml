<Window x:Class="CityFinder.App.Views.PhotoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CityFinder.App.Views"
        Title="Fiche photo"
        Icon="pack://application:,,,/Assets/CityFinder.ico"
        Width="1080" Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:DialogTitleBar Grid.Row="0" Title="Fiche photo"
                                  CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.06*"/>
                    <ColumnDefinition Width="0.94*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#0D0C0B" ClipToBounds="True">
                    <Image x:Name="DetailImage" Stretch="Uniform" Margin="24"/>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                            CornerRadius="99" Padding="9,4" Background="#660D0C0B"
                            BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock Text="{Binding GpsBadgeText}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGps}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock x:Name="ImagePlaceholder" Text="Aperçu indisponible"
                               Foreground="#8FA096" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="ImageLoading" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Style="{StaticResource SpinnerPath}"
                              Data="M12 3a9 9 0 1 1-6.4 2.7" Stroke="#8FA096"
                              StrokeThickness="2" Fill="Transparent" Stretch="Uniform"
                              Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chargement de l'aperçu…" FontSize="10.5"
                                   Foreground="#8FA096" Margin="0,9,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,22">
                        <TextBlock Text="{Binding DetailEyebrow}" FontSize="9.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="24" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DetailSubtitle}" FontSize="10.5"
                                   Foreground="{DynamicResource InkMuted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="COMMUNE" Style="{StaticResource DetailMetaLabel}"
                                   Margin="2,18,0,6"/>
                        <Grid>
                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldTextBox}" FontSize="14"
                                     FontWeight="SemiBold" LostFocus="Field_LostFocus"
                                     ToolTip="Ville ajoutée au nom du fichier"/>
                            <TextBlock Text="Saisir une ville" FontSize="13"
                                       Foreground="{DynamicResource InkMuted}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding City,
                                                    Converter={StaticResource EmptyStringToVisibility}}"/>
                        </Grid>
                        <TextBlock Text="{Binding CityHint}" FontSize="10"
                                   Foreground="{DynamicResource InkMuted}"
                                   TextWrapping="Wrap" Margin="2,5,0,0"/>

                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="9"
                                Padding="10,8" Margin="0,8,0,0"
                                Visibility="{Binding HasCitySuggestion,
                                             Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="10" Foreground="{DynamicResource InkMuted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Photon propose : "/><Run Text="{Binding SuggestionCity, Mode=OneWay}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}"/>
                                </TextBlock>
                                <Button Grid.Column="1" Content="Utiliser"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding UseSuggestionCommand}"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="2,8,0,0"
                                    Visibility="{Binding HasExistingCity,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <Path Data="M5 12l4 4L19 6" Stroke="{DynamicResource InkMuted}"
                                  StrokeThickness="1.7" Fill="Transparent" Stretch="Uniform"
                                  Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ExistingCityText}" FontSize="9.5"
                                       Foreground="{DynamicResource InkMuted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="TEXTE ADDITIONNEL · OPTIONNEL"
                                   Style="{StaticResource DetailMetaLabel}" Margin="2,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBox}" FontSize="12"
                                         LostFocus="Field_LostFocus"
                                         ToolTip="Texte optionnel ajouté après la ville"/>
                                <TextBlock Text="Ex. anniversaire, vue du château…" FontSize="11.5"
                                           Foreground="{DynamicResource InkMuted}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text,
                                                        Converter={StaticResource EmptyStringToVisibility}}"/>
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource SmallIconButton}"
                                    Content="×" FontSize="13" Command="{Binding ClearTextCommand}"
                                    ToolTip="Effacer le texte" AutomationProperties.Name="Effacer le texte"
                                    Margin="4,0,0,0"
                                    Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0,0,7,7">
                                <StackPanel>
                                    <TextBlock Text="COORDONNÉES" Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding CoordinateLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="PRISE DE VUE" Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding DateLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0,0,7,7">
                                <StackPanel>
                                    <TextBlock Text="APPAREIL" Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding DeviceLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="DIMENSIONS" Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding DimensionsLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="PAYS / RÉGION" Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding RegionLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailMetaCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="COMMUNE DÉTECTÉE"
                                               Style="{StaticResource DetailMetaLabel}"/>
                                    <TextBlock Text="{Binding PhotonCityLabel}"
                                               Style="{StaticResource DetailMetaValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="9" Padding="10,8" Margin="0,11,0,0">
                            <StackPanel>
                                <TextBlock Text="NOUVEAU NOM" Style="{StaticResource DetailMetaLabel}"/>
                                <TextBlock Text="{Binding TargetNamePreview}" FontFamily="Consolas"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCity}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="OpenOsmButton" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0"
                                Click="OpenOsm_Click"
                                Visibility="{Binding HasGps, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z M9 3v15 M15 6v15"
                                      Stroke="{DynamicResource Ink}" StrokeThickness="1.5"
                                      Fill="Transparent" Stretch="Uniform" Width="13" Height="13"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Voir sur OpenStreetMap" FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{DynamicResource WarningSoft}"
                                BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                CornerRadius="9" Padding="10,8" Margin="0,11,0,0"
                                Visibility="{Binding HasGps,
                                             Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Aucune coordonnée GPS détectée. Saisissez une commune pour inclure cette photo."
                                       FontSize="10" Foreground="{DynamicResource Warning}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                Margin="0,15,0,0" Padding="0,13,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource CardCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSelectionEnabled}"
                                              ToolTip="Inclure cette photo dans le renommage"
                                              AutomationProperties.Name="Inclure cette photo"/>
                                    <TextBlock Text="Inclure dans le renommage" FontSize="11.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="Terminé" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Padding="18,8"
                                        Click="Done_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
