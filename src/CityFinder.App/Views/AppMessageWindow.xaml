<Window x:Class="CityFinder.App.Views.AppMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CityFinder.App.Views"
        Title="CityFinder"
        Icon="pack://application:,,,/Assets/CityFinder.ico"
        Width="580" Height="390"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Title="Information"
                                  CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ToneBadge" Width="44" Height="44" CornerRadius="12"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ToneGlyph" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HeadingText" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="24" TextWrapping="Wrap" MaxWidth="450"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,16,0,0" MaxHeight="210">
                    <TextBlock x:Name="MessageText" FontSize="12.5" LineHeight="20"
                               TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"/>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="CityFinder" FontSize="10"
                               Foreground="{DynamicResource InkMuted}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="Secondary_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                                Click="Primary_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
