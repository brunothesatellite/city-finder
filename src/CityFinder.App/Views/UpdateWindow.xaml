<Window x:Class="CityFinder.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CityFinder.App.Views"
        Title="Mise à jour"
        Icon="pack://application:,,,/Assets/CityFinder.ico"
        Width="720" Height="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Title="Mise à jour"
                                  CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="MISE À JOUR DISPONIBLE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="HeadingText" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="28" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentText" FontSize="11.5"
                               Foreground="{DynamicResource InkMuted}" Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="NOUVEAUTÉS" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource InkMuted}"/>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="NotesText" FontSize="11.5" LineHeight="19"
                                       Foreground="{DynamicResource Ink}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Border x:Name="ProgressPanel" Background="{DynamicResource SurfaceAlt}"
                            CornerRadius="9" Padding="11,9" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProgressText" FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}"/>
                            <ProgressBar x:Name="ProgressBar" Style="{StaticResource SlimProgressBar}"
                                         Height="7" Maximum="100" Value="0" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" FontSize="10.5"
                               Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" Margin="2,8,0,0"/>
                    <TextBlock FontSize="9.5" Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" Margin="2,4,0,0">
                        <Run Text="Archive officielle GitHub · empreinte SHA-256 vérifiée avant installation. "/>
                        <Hyperlink x:Name="ReleaseLink" RequestNavigate="ReleaseLink_RequestNavigate">
                            Voir la release
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock Text="Les photos et la session restent intactes."
                               FontSize="10" Foreground="{DynamicResource InkMuted}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LaterButton" Content="Plus tard"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="Later_Click"/>
                        <Button x:Name="InstallButton" Content="Télécharger et installer"
                                Style="{StaticResource PrimaryButton}"
                                Click="Install_Click"/>
                        <Button x:Name="RestartButton" Content="Redémarrer et installer"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="Collapsed" Click="Restart_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
