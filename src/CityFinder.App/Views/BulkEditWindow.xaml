<Window x:Class="CityFinder.App.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CityFinder.App.Views"
        Title="Modifier en groupe"
        Icon="pack://application:,,,/Assets/CityFinder.ico"
        Width="680" Height="630"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Title="Modifier en groupe"
                                  CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="ACTION GROUPÉE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="HeadingText" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="26" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11.5"
                               Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="APPLIQUER À" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource InkMuted}" Margin="2,0,0,7"/>
                    <RadioButton x:Name="SelectedScope" Style="{StaticResource ChoiceRadioButton}"
                                 GroupName="BulkScope" Checked="Scope_Changed"/>
                    <RadioButton x:Name="VisibleScope" Style="{StaticResource ChoiceRadioButton}"
                                 GroupName="BulkScope" Margin="0,6,0,0" Checked="Scope_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock x:Name="FieldLabelText" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource InkMuted}" Margin="2,0,0,7"/>
                    <Grid>
                        <TextBox x:Name="ValueInput" Style="{StaticResource FieldTextBox}"
                                 FontSize="13" Padding="11,9" TextChanged="ValueInput_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText" FontSize="12"
                                   Foreground="{DynamicResource InkMuted}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=ValueInput,
                                                Converter={StaticResource EmptyStringToVisibility}}"/>
                    </Grid>
                    <TextBlock x:Name="HintText" FontSize="10.5"
                               Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" Margin="2,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="11" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="APERÇU DU NOM CIBLE" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{DynamicResource InkMuted}"/>
                            <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Ink}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="PreviewSourceText" FontSize="9.5"
                                       Foreground="{DynamicResource InkMuted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OverwritePanel" Background="{DynamicResource WarningSoft}"
                            BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                            CornerRadius="9" Padding="11,8" Margin="0,9,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 3 22 21H2L12 3z M12 10v4 M12 17h.01"
                                  Stroke="{DynamicResource Warning}" StrokeThickness="1.5"
                                  Fill="Transparent" Stretch="Uniform" Width="13" Height="13"
                                  VerticalAlignment="Top" Margin="0,1,7,0"/>
                            <TextBlock x:Name="OverwriteText" FontSize="10.5"
                                       Foreground="{DynamicResource Warning}"
                                       TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Text="Une confirmation sera demandée avant tout remplacement."
                               FontSize="10" Foreground="{DynamicResource InkMuted}"
                               VerticalAlignment="Center" MaxWidth="330"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="Cancel_Click"/>
                        <Button x:Name="ApplyButton" Content="Appliquer" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
